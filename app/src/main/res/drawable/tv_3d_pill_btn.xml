<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#4D682B" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:endColor="#A6C177"
                        android:startColor="#D8EBAC" />
                    <corners android:radius="14dp" />
                    <stroke android:width="2dp" android:color="#FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#101D42" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:endColor="#264085"
                        android:startColor="#3E62BD" />
                    <corners android:radius="14dp" />
                    <stroke android:width="1dp" android:color="#587CE0" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
