<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#44000000" />
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="315"
                        android:endColor="#E6B8E1FF"
                        android:startColor="#F2FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#44070D1E" />
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="315"
                        android:endColor="#A6192C57"
                        android:startColor="#CC38589E" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
