<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A2C5E"
    android:keepScreenOn="true">

    <!-- ЭКРАН 1: КАТЕГОРИИ В 2 КОЛОНКИ (СИНИЙ СТИЛЬ СО СКРУГЛЁННЫМИ ИКОНКАМИ) -->
    <LinearLayout
        android:id="@+id/screenCategories"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:background="#14234D"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="18dp"
                android:letterSpacing="0.06"
                android:text="LUMATV"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPlaylistSelectorTop"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/tv_3d_pill_btn"
                android:focusable="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Плейлист: VipLime ▼"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnSearchMain"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/tv_3d_circle_btn"
                android:focusable="true"
                android:text="🔍"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnRefreshMain"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/tv_3d_circle_btn"
                android:focusable="true"
                android:text="↻"
                android:textColor="#FFFFFF"
                android:textSize="19sp" />

            <Button
                android:id="@+id/btnSettingsMain"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/tv_3d_circle_btn"
                android:focusable="true"
                android:text="⚙"
                android:textColor="#FFFFFF"
                android:textSize="19sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCategories"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="14dp" />
    </LinearLayout>

    <!-- ЭКРАН 2: КАНАЛЫ КАТЕГОРИИ В 2 КОЛОНКИ С ПОЛОСКОЙ ПРОГРЕССА -->
    <LinearLayout
        android:id="@+id/screenCategoryChannels"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:background="#14234D"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="24dp">

            <Button
                android:id="@+id/btnBackFromCategory"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/tv_3d_circle_btn"
                android:focusable="true"
                android:text="←"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvCategoryHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Категория"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSearchCategory"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/tv_3d_circle_btn"
                android:focusable="true"
                android:text="🔍"
                android:textSize="16sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCategoryChannels"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="14dp" />
    </LinearLayout>

    <!-- ЭКРАН 3: ПЛЕЕР (РЕЖИМ ПРЕВЬЮ СЛЕВА + ПОЛНЫЙ ЭКРАН + БЫСТРЫЙ СПИСОК + ИНФО О ПЕРЕДАЧЕ) -->
    <FrameLayout
        android:id="@+id/screenPlayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0D1733"
        android:visibility="gone">

        <!-- ОСНОВНОЙ КОНТЕЙНЕР: СЛЕВА (ВИДЕО + ПОЛОСА + КНОПКИ ПОД ВИДЕО), СПРАВА (EPG / АРХИВ) -->
        <LinearLayout
            android:id="@+id/splitRootContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- ЛЕВАЯ КОЛОНКА: ВЕРХ — ОКНО ВИДЕО, НИЗ — ПОЛОСА И ОБЪЁМНЫЕ КНОПКИ ПОД ВИДЕО -->
            <LinearLayout
                android:id="@+id/leftVideoAndControlsColumn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.18"
                android:orientation="vertical">

                <!-- ОКНО ТРАНСЛЯЦИИ -->
                <FrameLayout
                    android:id="@+id/playerVideoFrame"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="#000000">

                    <androidx.media3.ui.PlayerView
                        android:id="@+id/playerView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:focusable="true"
                        app:resize_mode="fit"
                        app:use_controller="false" />

                    <TextView
                        android:id="@+id/tvClockOverlay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="16dp"
                        android:shadowColor="#000000"
                        android:shadowRadius="4"
                        android:text="02:03"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <!-- ПАНЕЛЬ УПРАВЛЕНИЯ И ПОЛОСА ТРАНСЛЯЦИИ СТРОГО ПОД ВИДЕО (КАК НА ФОТО 3 И 4) -->
                <LinearLayout
                    android:id="@+id/playerControlBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#E615244D"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="46dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/logo_box_bg">

                            <TextView
                                android:id="@+id/tvOsdBadge"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="ТВ"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/ivOsdLogo"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="3dp"
                                android:scaleType="fitCenter" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvOsdChannelName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Канал"
                                android:textColor="#CBD8F8"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvOsdCurrentShow"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Прямой эфир"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvOsdNextShow"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Далее: программа передач"
                                android:textColor="#A8BCE8"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvOsdTimeRight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="21:00\nДалее 05:00"
                            android:textColor="#CBD8F8"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/osdProgressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="10dp"
                        android:max="100"
                        android:progress="45"
                        android:progressBackgroundTint="#2A4282"
                        android:progressTint="#EAB308" />

                    <!-- ОБЪЁМНЫЕ 3D КНОПКИ УПРАВЛЕНИЯ ПОД ВИДЕО -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnOsdFullscreen"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/tv_3d_circle_btn"
                            android:focusable="true"
                            android:nextFocusLeft="@id/btnOsdInfo"
                            android:nextFocusRight="@id/btnOsdPlayPause"
                            android:nextFocusUp="@id/tabLiveProgram"
                            android:text="⛶"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp" />

                        <Button
                            android:id="@+id/btnOsdPlayPause"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/tv_3d_circle_btn"
                            android:focusable="true"
                            android:nextFocusLeft="@id/btnOsdFullscreen"
                            android:nextFocusRight="@id/btnOsdQuickChannels"
                            android:nextFocusUp="@id/tabLiveProgram"
                            android:text="❚❚"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />

                        <Button
                            android:id="@+id/btnOsdQuickChannels"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/tv_3d_circle_btn"
                            android:focusable="true"
                            android:nextFocusLeft="@id/btnOsdPlayPause"
                            android:nextFocusRight="@id/btnOsdFavorite"
                            android:nextFocusUp="@id/tabLiveProgram"
                            android:text="☰"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp" />

                        <Button
                            android:id="@+id/btnOsdFavorite"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/tv_3d_circle_btn"
                            android:focusable="true"
                            android:nextFocusLeft="@id/btnOsdQuickChannels"
                            android:nextFocusRight="@id/btnOsdPip"
                            android:nextFocusUp="@id/tabLiveProgram"
                            android:text="♥"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp" />

                        <Button
                            android:id="@+id/btnOsdPip"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/tv_3d_circle_btn"
                            android:focusable="true"
                            android:nextFocusLeft="@id/btnOsdFavorite"
                            android:nextFocusRight="@id/btnOsdAspect"
                            android:nextFocusUp="@id/tabLiveProgram"
                            android:text="⧉"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp" />

                        <Button
                            android:id="@+id/btnOsdAspect"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/tv_3d_circle_btn"
                            android:focusable="true"
                            android:nextFocusLeft="@id/btnOsdPip"
                            android:nextFocusRight="@id/btnOsdQuality"
                            android:nextFocusUp="@id/tabLiveProgram"
                            android:text="⤢"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp" />

                        <Button
                            android:id="@+id/btnOsdQuality"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/tv_3d_circle_btn"
                            android:focusable="true"
                            android:nextFocusLeft="@id/btnOsdAspect"
                            android:nextFocusRight="@id/btnOsdInfo"
                            android:nextFocusUp="@id/tabLiveProgram"
                            android:text="⚙"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp" />

                        <Button
                            android:id="@+id/btnOsdInfo"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/tv_3d_circle_btn"
                            android:focusable="true"
                            android:nextFocusLeft="@id/btnOsdQuality"
                            android:nextFocusRight="@id/btnOsdFullscreen"
                            android:nextFocusUp="@id/tabLiveProgram"
                            android:text="ⓘ"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ПРАВАЯ КОЛОНКА: ВКЛАДКИ «ПРЯМОЙ ЭФИР» И «АРХИВ» -->
            <LinearLayout
                android:id="@+id/playerRightPanel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#1B2E63"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="#14234D"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <Button
                        android:id="@+id/tabLiveProgram"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/tv_tab_bg"
                        android:focusable="true"
                        android:nextFocusDown="@id/rvPlayerEpg"
                        android:nextFocusLeft="@id/btnOsdFullscreen"
                        android:nextFocusRight="@id/tabArchiveProgram"
                        android:text="Прямой эфир"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/tabArchiveProgram"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/tv_tab_bg"
                        android:focusable="true"
                        android:nextFocusDown="@id/rvPlayerEpg"
                        android:nextFocusLeft="@id/tabLiveProgram"
                        android:text="Архив"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPlayerEpg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:nextFocusDown="@id/btnOsdFullscreen"
                    android:nextFocusLeft="@id/btnOsdFullscreen"
                    android:nextFocusUp="@id/tabLiveProgram" />
            </LinearLayout>
        </LinearLayout>

        <!-- ОВЕРЛЕЙ 1 (ФОТО 5): БЫСТРЫЙ СПИСОК КАНАЛОВ КАТЕГОРИИ ПО КНОПКЕ ВНИЗ В ПОЛНОМ ЭКРАНЕ -->
        <LinearLayout
            android:id="@+id/quickChannelOverlay"
            android:layout_width="420dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="#EE15244D"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="◀ "
                    android:textColor="#C9DE9E"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvQuickCategoryTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="Категория"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" ▶"
                    android:textColor="#C9DE9E"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:text="◀▶ Категория   •   ▲▼ Выбор   •   ОК Включить"
                android:textColor="#A8BCE8"
                android:textSize="12sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvQuickChannels"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <!-- ОВЕРЛЕЙ 2 (ФОТО 6): ПОДРОБНАЯ ИНФОРМАЦИЯ О ТРАНСЛЯЦИИ ПО КНОПКЕ ВВЕРХ В ПОЛНОМ ЭКРАНЕ -->
        <LinearLayout
            android:id="@+id/programInfoOverlay"
            android:layout_width="540dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/info_card_bg"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvInfoShowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Название передачи"
                android:textColor="#FBBF24"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Качество потока"
                android:textColor="#A8BCE8"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvInfoStreamSpecs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Видео: Авто, Аудио: Русский"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Описание"
                android:textColor="#A8BCE8"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/tvInfoShowDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.2"
                    android:text="Описание передачи из программы EPG."
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
            </ScrollView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="end"
                android:text="Нажмите «Назад» или «ОК», чтобы закрыть"
                android:textColor="#CBD8F8"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- ЭКРАН 4: НАСТРОЙКИ -->
    <LinearLayout
        android:id="@+id/screenSettings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1A2C5E"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:background="#14234D"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="24dp">

            <Button
                android:id="@+id/btnCloseSettings"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/tv_3d_circle_btn"
                android:focusable="true"
                android:text="✕"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Настройки"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnSetPlaylists"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/tv_row_bg"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:paddingStart="22dp"
                    android:text="Плейлисты (выбор и добавление новых)"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp" />

                <Button
                    android:id="@+id/btnSetEpg"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/tv_row_bg"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:paddingStart="22dp"
                    android:text="Источник программы передач EPG (Lite / Full)"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp" />

                <Button
                    android:id="@+id/btnSetVideoAudio"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginBottom="8dp"
