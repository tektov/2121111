<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootWindowContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050B18"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:keepScreenOn="true">

    <ImageView
        android:id="@+id/ivGlobalWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_wallpaper_aurora" />

    <!-- ЭКРАН 1: КАТЕГОРИИ В 2 КОЛОНКИ -->
    <LinearLayout
        android:id="@+id/screenCategories"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="visible">

        <LinearLayout
            android:id="@+id/topBarCategories"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/liquid_glass_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <ImageView
                android:id="@+id/ivAppLogoIcon"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_auratv_logo" />

            <TextView
                android:id="@+id/tvAppLogoTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:letterSpacing="0.06"
                android:text="AURATV"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPlaylistSelectorTop"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/liquid_glass_pill"
                android:focusable="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Плейлист: VipLime ▼"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnSearchMain"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/liquid_glass_3d_btn"
                android:focusable="true"
                android:text="🔍"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnRefreshMain"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/liquid_glass_3d_btn"
                android:focusable="true"
                android:text="↻"
                android:textColor="#FFFFFF"
                android:textSize="19sp" />

            <Button
                android:id="@+id/btnSettingsMain"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/liquid_glass_3d_btn"
                android:focusable="true"
                android:text="⚙"
                android:textColor="#FFFFFF"
                android:textSize="19sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCategories"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false" />
    </LinearLayout>

    <!-- ЭКРАН 2: КАНАЛЫ / КИНОТЕАТРЫ КАТЕГОРИИ С ФИЛЬТРАМИ ПО ГОДУ, ЖАНРУ И СТРАНЕ -->
    <LinearLayout
        android:id="@+id/screenCategoryChannels"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/topBarChannels"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/liquid_glass_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <Button
                android:id="@+id/btnBackFromCategory"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/liquid_glass_3d_btn"
                android:focusable="true"
                android:text="←"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvCategoryHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Категория"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSearchCategory"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/liquid_glass_3d_btn"
                android:focusable="true"
                android:text="🔍"
                android:textSize="15sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCategoryChannels"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false" />
    </LinearLayout>

    <!-- ЭКРАН 3: ПЛЕЕР -->
    <FrameLayout
        android:id="@+id/screenPlayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/videoStageContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000">

            <androidx.media3.ui.PlayerView
                android:id="@+id/playerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:focusable="true"
                app:resize_mode="fit"
                app:surface_type="texture_view"
                app:use_controller="false" />

            <TextView
                android:id="@+id/tvClockOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="18dp"
                android:shadowColor="#000000"
                android:shadowRadius="4"
                android:text="02:00"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPlayerStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="18dp"
                android:background="@drawable/liquid_glass_panel"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
                android:text="Буферизация..."
                android:textColor="#38BDF8"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/miniZapBanner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="22dp"
                android:background="@drawable/liquid_glass_panel"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingTop="12dp"
                android:paddingEnd="20dp"
                android:paddingBottom="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvZapChannelName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Канал"
                    android:textColor="#38BDF8"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvZapShowName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:ellipsize="end"
                    android:maxWidth="400dp"
                    android:maxLines="1"
                    android:text="Прямой эфир"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/playerRightPanel"
            android:layout_width="440dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:layout_margin="10dp"
            android:background="@drawable/liquid_glass_panel"
            android:orientation="vertical"
            android:padding="6dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:padding="3dp">

                <Button
                    android:id="@+id/tabLiveProgram"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/tv_tab_bg"
                    android:focusable="true"
                    android:nextFocusDown="@id/rvPlayerEpg"
                    android:nextFocusLeft="@id/btnOsdFullscreen"
                    android:nextFocusRight="@id/tabArchiveProgram"
                    android:text="Прямой эфир"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/tabArchiveProgram"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/tv_tab_bg"
                    android:focusable="true"
                    android:nextFocusDown="@id/rvPlayerEpg"
                    android:nextFocusLeft="@id/tabLiveProgram"
                    android:text="Архив"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPlayerEpg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:nextFocusDown="@id/btnOsdFullscreen"
                android:nextFocusLeft="@id/btnOsdFullscreen"
                android:nextFocusUp="@id/tabLiveProgram" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/playerControlBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="16dp"
            android:background="@drawable/liquid_glass_panel"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="14dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/logo_box_bg">

                    <TextView
                        android:id="@+id/tvOsdBadge"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="ТВ"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/ivOsdLogo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="3dp"
                        android:scaleType="fitCenter" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvOsdChannelName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Канал"
                        android:textColor="#7DD3FC"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOsdCurrentShow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Прямой эфир"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOsdNextShow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Далее: программа передач"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvOsdTimeRight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="21:00\nДалее 05:00"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/osdSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:focusable="true"
                android:max="100"
                android:nextFocusDown="@id/btnOsdFullscreen"
                android:nextFocusUp="@id/tabLiveProgram"
                android:progress="45" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnOsdFullscreen"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/liquid_glass_3d_btn"
                    android:focusable="true"
                    android:nextFocusLeft="@id/btnOsdInfo"
                    android:nextFocusRight="@id/btnOsdRewind"
                    android:nextFocusUp="@id/osdSeekBar"
                    android:text="⛶"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp" />

                <Button
                    android:id="@+id/btnOsdRewind"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/liquid_glass_3d_btn"
                    android:focusable="true"
                    android:nextFocusLeft="@id/btnOsdFullscreen"
                    android:nextFocusRight="@id/btnOsdPlayPause"
                    android:nextFocusUp="@id/osdSeekBar"
                    android:text="⏪"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnOsdPlayPause"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/liquid_glass_3d_btn"
                    android:focusable="true"
                    android:nextFocusLeft="@id/btnOsdRewind"
                    android:nextFocusRight="@id/btnOsdForward"
                    android:nextFocusUp="@id/osdSeekBar"
                    android:text="❚❚"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnOsdForward"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/liquid_glass_3d_btn"
                    android:focusable="true"
                    android:nextFocusLeft="@id/btnOsdPlayPause"
                    android:nextFocusRight="@id/btnOsdQuickChannels"
                    android:nextFocusUp="@id/osdSeekBar"
                    android:text="⏩"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnOsdQuickChannels"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/liquid_glass_3d_btn"
                    android:focusable="true"
                    android:nextFocusLeft="@id/btnOsdForward"
                    android:nextFocusRight="@id/btnOsdFavorite"
                    android:nextFocusUp="@id/osdSeekBar"
                    android:text="☰"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnOsdFavorite"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/liquid_glass_3d_btn"
                    android:focusable="true"
                    android:nextFocusLeft="@id/btnOsdQuickChannels"
                    android:nextFocusRight="@id/btnOsdPip"
                    android:nextFocusUp="@id/osdSeekBar"
                    android:text="♥"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnOsdPip"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/liquid_glass_3d_btn"
                    android:focusable="true"
                    android:nextFocusLeft="@id/btnOsdFavorite"
                    android:nextFocusRight="@id/btnOsdAspect"
                    android:nextFocusUp="@id/osdSeekBar"
                    android:text="⧉"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnOsdAspect"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/liquid_glass_3d_btn"
                    android:focusable="true"
                    android:nextFocusLeft="@id/btnOsdPip"
                    android:nextFocusRight="@id/btnOsdQuality"
                    android:nextFocusUp="@id/osdSeekBar"
                    android:text="⤢"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp" />

                <Button
                    android:id="@+id/btnOsdQuality"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/liquid_glass_3d_btn"
                    android:focusable="true"
                    android:nextFocusLeft="@id/btnOsdAspect"
                    android:nextFocusRight="@id/btnOsdInfo"
                    android:nextFocusUp="@id/osdSeekBar"
                    android:text="⚙"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp" />

                <Button
                    android:id="@+id/btnOsdInfo"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/liquid_glass_3d_btn"
                    android:focusable="true"
                    android:nextFocusLeft="@id/btnOsdQuality"
                    android:nextFocusRight="@id/btnOsdFullscreen"
                    android:nextFocusUp="@id/osdSeekBar"
                    android:text="ⓘ"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/quickChannelOverlay"
            android:layout_width="420dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:layout_margin="12dp"
            android:background="@drawable/liquid_glass_panel"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnQuickPrevCat"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/liquid_glass_3d_btn"
                    android:clickable="true"
                    android:focusable="false"
                    android:text="◀"
                    android:textColor="#7DD3FC"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvQuickCategoryTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="Категория"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnQuickNextCat"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/liquid_glass_3d_btn"
                    android:clickable="true"
                    android:focusable="false"
                    android:text="▶"
                    android:textColor="#7DD3FC"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnQuickClose"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/liquid_glass_3d_btn"
                    android:clickable="true"
                    android:focusable="false"
                    android:text="✕"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:text="◀▶ Категория   •   ▲▼ Выбор   •   ОК Включить"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvQuickChannels"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/programInfoOverlay"
            android:layout_width="540dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/liquid_glass_panel"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvInfoShowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Название передачи"
                android:textColor="#38BDF8"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Качество потока"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvInfoStreamSpecs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Видео: Авто, Аудио: Русский"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Описание"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/tvInfoShowDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.2"
                    android:text="Описание передачи из программы EPG."
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
            </ScrollView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="end"
                android:text="Нажмите «Назад» или «ОК», чтобы закрыть"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- ПЛАВАЮЩЕЕ МИНИ-ОКНО PiP -->
    <FrameLayout
        android:id="@+id/floatingPipContainer"
        android:layout_width="340dp"
        android:layout_height="192dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:background="@drawable/liquid_glass_panel"
        android:elevation="16dp"
        android:padding="4dp"
        android:visibility="gone">

        <androidx.media3.ui.PlayerView
            android:id="@+id/pipPlayerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="fit"
            app:surface_type="texture_view"
            app:use_controller="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#CC0E1A36"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="6dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/tvPipTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Канал в мини-окне"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPipExpand"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/liquid_glass_3d_btn"
                android:focusable="true"
                android:nextFocusRight="@id/btnPipClose"
                android:text="⛶"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnPipClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/liquid_glass_3d_btn"
                android:focusable="true"
                android:nextFocusLeft="@id/btnPipExpand"
                android:text="✕"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- ЭКРАН 4: НАСТРОЙКИ -->
    <LinearLayout
        android:id="@+id/screenSettings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/topBarSettings"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/liquid_glass_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="20dp">

            <Button
                android:id="@+id/btnCloseSettings"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/liquid_glass_3d_btn"
                android:focusable="true"
                android:text="✕"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Настройки AuraTV"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnSetLayoutMode"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/liquid_glass_row"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:paddingStart="22dp"
                    android:text="Вид категорий и каналов: 2 колонки"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp" />

                <Button
                    android:id="@+id/btnSetColorTheme"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/liquid_glass_row"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:paddingStart="22dp"
                    android:text="Цветовая тема интерфейса: Королевский синий"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp" />

                <Button
                    android:id="@+id/btnSetNeonGlow"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/liquid_glass_row"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:paddingStart="22dp"
                    android:text="Свечение Ambilight под окнами: Мягкий голубой Ambilight"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp" />

                <LinearLayout
                    android:id="@+id/opacitySliderCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/liquid_glass_row"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingStart="22dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvOpacityLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Прозрачность окон и плеера (◀▶ на пульте)"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvOpacityPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="85%"
                            android:textColor="#38BDF8"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seekBarGlassOpacity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:focusable="true"
                        android:max="100"
                        android:progress="85" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnSetWallpaper"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/liquid_glass_row"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:paddingStart="22dp"
                    android:text="Фоновое изображение: Северное сияние"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp" />

                <Button
                    android:id="@+id/btnSetPlaylists"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/liquid_glass_row"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:paddingStart="22dp"
                    android:text="Плейлисты (выбор и добавление новых)"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp" />

                <Button
                    android:id="@+id/btnSetEpg"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/liquid_glass_row"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:paddingStart="22dp"
                    android:text="Источник программы передач EPG (Lite / Full)"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp" />

                <Button
                    android:id="@+id/btnSetVideoAudio"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/liquid_glass_row"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:paddingStart="22dp"
                    android:text="Видео и аудио (масштабы, 4K–720p, дорожки)"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp" />

                <Button
                    android:id="@+id/btnSetBuffer"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/liquid_glass_row"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:paddingStart="22dp"
                    android:text="Буферизация видео: 10 сек"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp" />

                <Button
                    android:id="@+id/btnSetRefreshPlaylist"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/liquid_glass_row"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:paddingStart="22dp"
                    android:text="Обновить плейлист"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp" />

                <Button
                    android:id="@+id/btnSetRefreshEpg"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/liquid_glass_row"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:paddingStart="22dp"
                    android:text="Обновить программу передач"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp" />
            </LinearLayout>
        </ScrollView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:padding="12dp"
            android:text="AuraTV v23.0 • VipLime Edition"
            android:textColor="#CBD5E1"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- НАТИВНОЕ СТЕКЛЯННОЕ МОДАЛЬНОЕ ОКНО LIQUID GLASS (ВМЕСТО СИСТЕМНОГО ALERTDIALOG) -->
    <FrameLayout
        android:id="@+id/glassModalOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#88040814"
        android:clickable="true"
        android:elevation="24dp"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/glassModalCard"
            android:layout_width="520dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/liquid_glass_panel"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:id="@+id/tvGlassModalTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Выберите пункт"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvGlassModalOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="420dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="end"
                android:text="Нажмите «Назад» для закрытия"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
